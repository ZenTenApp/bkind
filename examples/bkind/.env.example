# Copy to .env and adjust. `docker compose` reads .env automatically.
#
# The exact URL clients connect to. NIP-42 auth events carry it in a "relay" tag
# and NIP-62 vanish requests are matched against it, so a mismatch means every
# write is refused with "auth-required".
#
# Local or behind your own proxy:
BKIND_URL=ws://127.0.0.1:3334
# With the "tls" profile (Caddy terminates TLS):
#BKIND_URL=wss://dm.example.com
#BKIND_DOMAIN=dm.example.com

# host port to publish on loopback
#BKIND_PORT=3334

# how often expired events are swept out of the store
#BKIND_SWEEP_INTERVAL=5m

# logging: text on stderr at info. warn silences badger's INFO lines, debug adds its
# debug records, json suits a log shipper.
#BKIND_LOG_LEVEL=info
#BKIND_LOG_FORMAT=text

# the policy set (kinds, expiration, limits, rate limits) is the binary's default:
# a Kind-4 DM relay. To change it, mount a JSON file and name it here, or pass the
# document inline — see docs/cookbook/configuration.md
#BKIND_CONFIG=/etc/bkind/bkind.json
#BKIND_CONFIG_JSON={"content":{"max":2048}}

# individual settings, when a whole file is overkill
#BKIND_MAX_EXPIRATION=75h
#BKIND_MAX_CONTENT=4096
#BKIND_MAX_TAGS=16
#BKIND_KINDS=4,5,62
