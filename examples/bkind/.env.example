# Copy to .env and adjust. `docker compose` reads .env automatically.
#
# The exact URL clients connect to. NIP-42 auth events carry it in a "relay" tag
# and NIP-62 vanish requests are matched against it, so a mismatch means every
# write is refused with "auth-required".
#
# Local or behind your own proxy:
BKIND_URL=ws://127.0.0.1:3334
# With the "tls" profile (Caddy terminates TLS):
#BKIND_URL=wss://dm.example.com
#BKIND_DOMAIN=dm.example.com

# host port to publish on loopback
#BKIND_PORT=3334

# how often expired events are swept out of the store
#BKIND_SWEEP_INTERVAL=5m

# write rules, must match what the NIP-11 document promises
#BKIND_MAX_EXPIRATION=75h
#BKIND_MAX_CONTENT=4096
#BKIND_MAX_TAGS=16
