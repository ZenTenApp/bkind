{
  "kinds": {
    "whitelist": [4, 1059],
    "allow_ephemeral": false,
    "reject_unserved_filters": true
  },
  "rules": {
    "1059": {
      "description": "Private Direct Message",
      "write": {
        "allow": ["*"]
      },
      "read": {
        "allow": ["*"],
        "privileged": true
      },
      "require_auth": true,
      "max_event_size": 65536,
      "max_event_content_size": 4096,
      "max_expiration": "3d",
      "max_age_of_event": "2d",
      "max_age_event_in_future": "1m",
      "p_tag": "hex",
      "required_tags": ["p", "expiration", "client"],
      "tag_patterns": {},
      "tag_limits": {"max_tags": 16, "max_tag_name_chars": 64, "max_tag_value_chars": 256},
      "rate_limits": [
        {"scope": "npub", "limit": 30, "window": "1h"},
        {"scope": "npub", "limit": 200, "window": "1d"},
        {"scope": "ip", "limit": 60, "window": "1h"},
        {"scope": "ip", "limit": 400, "window": "1d"}
      ],
      "errors": {}
    },
    "4": {
      "description": "Nostr DM events",
      "write": {
        "allow": ["*"]
      },
      "read": {
        "allow": ["*"],
        "privileged": true
      },
      "require_auth": true,
      "max_event_size": 65536,
      "max_event_content_size": 4096,
      "max_expiration": "3d",
      "max_age_of_event": "1h",
      "max_age_event_in_future": "1m",
      "p_tag": "hex",
      "required_tags": ["p", "expiration", "client"],
      "tag_patterns": {},
      "tag_limits": {"max_tags": 16, "max_tag_name_chars": 64, "max_tag_value_chars": 256},
      "rate_limits": [
        {"scope": "npub", "limit": 30, "window": "1h"},
        {"scope": "npub", "limit": 200, "window": "1d"},
        {"scope": "ip", "limit": 60, "window": "1h"},
        {"scope": "ip", "limit": 400, "window": "1d"}
      ],
      "errors": {}
    }
  },
  "filters": {"reject_empty": true, "reject_search": true},
  "read_limits": [
    {"scope": "npub", "limit": 60, "window": "1h"},
    {"scope": "npub", "limit": 400, "window": "1d"},
    {"scope": "ip", "limit": 120, "window": "1h"},
    {"scope": "ip", "limit": 800, "window": "1d"}
  ],
  "connection_limits": [
    {"scope": "ip", "limit": 120, "window": "1h"}
  ],
  "count": {"reject": true},
  "nip11": {
    "name": "B Kind",
    "description": "",
    "max_message_length": 12288,
    "max_subscriptions": 10,
    "max_filters": 4,
    "max_limit": 500,
    "extra_nips": []
  },
  "negentropy": false
}
